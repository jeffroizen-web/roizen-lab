# macOS
.DS_Store

# Environment
.env
.env.local

# Claude
.claude/
.playwright-mcp/

# Node (if any future build tools)
node_modules/

# Python
__pycache__/
*.pyc

# Cron + bus emit churn (signal lives in reports/, not in logs)
docs/reports/cron.stdout.log
docs/reports/cron.stderr.log
decisions/bus_emit_log.jsonl

# Playwright artifacts
test-results/

# Dated tenure-readiness reports are ephemeral cron output (R4, 2026-07-03):
# rotated on disk (keep 14) + a tracked rolling -latest. Do not accumulate
# near-identical dated pairs in git.
docs/reports/tenure-readiness-20*.json
docs/reports/tenure-readiness-20*.md

# Derived Pages publish artifact (built by scripts/sync_publish.py, deployed to gh-pages)
publish/

# Auto-redeploy runtime state (deploy_publish.sh): last-deployed hash + outcome log
docs/reports/.deploy_last_hash
docs/reports/deploy-publish.jsonl

# Process evidence, never product (producer merge-condition, /pipe4 2026-07-05;
# restated live 2026-09-07 after archive_verify clause-7 found the rule had been
# swept into session_archive.md and was functionally gone). Heavy artifact dumps
# in the source root are what choked the Pages build — keep them on the branch.
loop-artifacts/
loop-output-*.md
